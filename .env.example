# Copy this file to .env and fill in the keys for the providers you plan to use.

# --- Providers (at least one key is required) ---
# Gemini via Google AI Studio (default provider)
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key
OPENROUTER_API_KEY=your_openrouter_key
ANTHROPIC_API_KEY=your_anthropic_key
# Anthropic-compatible proxies/gateways
# ANTHROPIC_AUTH_TOKEN=your_proxy_bearer_token
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01

# --- Model selection ---
# DEFAULT_LLM_PROVIDER accepts: gemini | openai | openrouter | anthropic
DEFAULT_LLM_PROVIDER=gemini
# Leave DEFAULT_MODEL unset to use the default for whichever provider is in play
# (gemini-3.6-flash / gpt-5.6-terra / claude-sonnet-5). If you do set it, it names
# a model of DEFAULT_LLM_PROVIDER above and is ignored when a call overrides the
# provider. openrouter has no default: pass a fully-qualified slug.
# DEFAULT_MODEL=gemini-3.6-flash

# --- Behaviour ---
USE_LEARNING_HISTORY=false

# --- HTTP transport hardening (only used with --http) ---
# Origins allowed to call /mcp from a browser. Unset = loopback origins only.
# Use a comma-separated list, or "*" to restore the pre-2.9 wildcard.
# CORS_ORIGIN=https://app.example.com
# Host headers accepted (DNS-rebinding protection). Unset = localhost/127.0.0.1/::1.
# Set this (or "*") when serving on a non-loopback hostname, e.g. in Docker.
# MCP_ALLOWED_HOSTS=mcp.internal
# Maximum JSON request body size. Defaults to 100kb.
# MCP_MAX_BODY_SIZE=100kb
